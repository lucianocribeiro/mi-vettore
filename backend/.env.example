# Server
PORT=4000
NODE_ENV=development

# JWT — cambiar en producción
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

ALLOW_REGISTER=false

# Supabase Postgres
# Transaction pooler (runtime) — user: postgres.<project-ref>
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (migrations) — user: postgres
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Supabase Storage (documentación — bucket privado)
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DOCS_BUCKET=documentacion

# Kilometraje: delta que dispara alerta de anomalía (no bloquea)
KM_ANOMALIA_MAX_DELTA=2000

# Frontend (links en emails M2) y CORS
APP_PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Si true, el backend sirve ../frontend/dist (deploy single-host)
SERVE_FRONTEND=false

# Comunicaciones automáticas (M3)
COMUNICACIONES_CRON_ENABLED=true
COMUNICACIONES_TZ=America/Argentina/Buenos_Aires

# SMTP — sin configurar, los envíos quedan en estado SIMULADO
# TODO (miércoles): confirmar mail institucional (probablemente Silvina) → NOTIF_FROM_EMAIL
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Mi Vettore <noreply@vettore.test>
NOTIF_FROM_EMAIL=

# Email de OT (campanita ya funciona). Bloqueado hasta que Patricio entregue casillas.
# Cuando estén: SMTP_* + OT_EMAIL_ENABLED=true. Opcional: OT_NOTIFY_EMAILS=a@x,b@y
OT_EMAIL_ENABLED=false
OT_NOTIFY_EMAILS=
