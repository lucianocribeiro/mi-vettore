// Mi Vettore — Prisma schema
//
// Desarrollo local: SQLite (cero configuración).
// Producción: cambiar provider a "postgresql" y DATABASE_URL a la connection string
// de Postgres. Los modelos no necesitan reescribirse.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENTE
  CHOFER
  PABLO
  SILVINA
  FACU
  PATRICIO
  JULIETA
  CARLA
}

enum UserStatus {
  ACTIVO
  INACTIVO
}

enum SegmentoCliente {
  ESTATICO
  CONSULTA
  CONFIRMACION
}

enum EstadoChofer {
  ACTIVO
  INACTIVO
}

enum EstadoCamioneta {
  OPERATIVA
  EN_TALLER
  DE_VACACIONES
  FUERA_SERVICIO
}

enum TipoEmpresa {
  PROPIA
  ALIADA
}

enum TipoTransporte {
  CONGELADO
  SUPERCONGELADO
  REFRIGERADO
  SECO
}

enum TipoPedido {
  ALTA
  BAJA
  CAMBIO_HORARIO
  CAMBIO_RUTA
  PEDIDO_ESPECIAL
}

enum EstadoPedido {
  PENDIENTE
  EN_CURSO
  RESUELTO
}

enum OrigenPedido {
  FORMULARIO
  MANUAL
  SISTEMA
}

model Usuario {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  rol          Role
  estado       UserStatus @default(ACTIVO)
  nombre       String?
  clienteId    String?
  choferId     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  cliente Cliente? @relation(fields: [clienteId], references: [id])
  chofer  Chofer?  @relation(fields: [choferId], references: [id])
}

model Cliente {
  id        String          @id @default(cuid())
  nombre    String
  segmento  SegmentoCliente @default(ESTATICO)
  contacto  String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  pedidos   Pedido[]
  usuarios  Usuario[]
}

model Chofer {
  id                   String           @id @default(cuid())
  nombre               String
  dni                  String           @unique
  cuil                 String?
  licencia             String?
  licenciaVencimiento  DateTime?
  telefono             String?
  email                String?
  /// Dueño de empresa de transporte: ve todas las unidades de su/s empresa/s.
  esDuenoFlota         Boolean          @default(false)
  estado               EstadoChofer     @default(ACTIVO)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  asignaciones         AsignacionFlota[]
  pedidos              Pedido[]
  usuarios             Usuario[]
  solicitudes          SolicitudTaller[]
}

model Camioneta {
  id                  String           @id @default(cuid())
  patente             String           @unique
  marca               String?
  modelo              String?
  anio                Int?
  color               String?
  tipoTransporte      TipoTransporte?
  datosTecnicos       String?
  km                  Int              @default(0)
  fechaUltimoAceite   DateTime?
  seguroCompania      String?
  seguroVencimiento   DateTime?
  /// VTB / revisión técnica — vencimiento
  vtbVencimiento      DateTime?
  estado              EstadoCamioneta  @default(OPERATIVA)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  asignaciones        AsignacionFlota[]
  pedidos             Pedido[]
  solicitudes         SolicitudTaller[]
}

model EmpresaTransporte {
  id           String           @id @default(cuid())
  nombre       String
  cuit         String?          @unique
  contacto     String?
  tipo         TipoEmpresa      @default(ALIADA)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  asignaciones AsignacionFlota[]
}

/// Historial de asignaciones camioneta ↔ chofer ↔ empresa.
/// Nunca se sobreescribe: un cambio cierra el período actual y crea un registro nuevo.
model AsignacionFlota {
  id           String    @id @default(cuid())
  camionetaId  String
  choferId     String
  empresaId    String
  periodoDesde DateTime
  periodoHasta DateTime?
  createdAt    DateTime  @default(now())

  camioneta Camioneta         @relation(fields: [camionetaId], references: [id])
  chofer    Chofer            @relation(fields: [choferId], references: [id])
  empresa   EmpresaTransporte @relation(fields: [empresaId], references: [id])

  @@index([camionetaId])
  @@index([choferId])
  @@index([empresaId])
}

/// Pedido / cambio operativo del panel de tráfico (M1).
model Pedido {
  id               String       @id @default(cuid())
  clienteId        String
  fecha            DateTime
  tipo             TipoPedido
  hora             String?
  zona             String?
  motivo           String
  estado           EstadoPedido @default(PENDIENTE)
  comentarioCierre String?
  choferId         String?
  camionetaId      String?
  origen           OrigenPedido @default(MANUAL)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  cliente   Cliente    @relation(fields: [clienteId], references: [id])
  chofer    Chofer?    @relation(fields: [choferId], references: [id])
  camioneta Camioneta? @relation(fields: [camionetaId], references: [id])

  @@index([fecha])
  @@index([estado])
  @@index([clienteId])
}

enum SolicitanteTaller {
  CHOFER
  ADMINISTRATIVO
}

/// Solicitud de reparación (paso 1 del circuito de talleres).
model SolicitudTaller {
  id                 String            @id @default(cuid())
  camionetaId        String
  choferId           String?
  solicitante        SolicitanteTaller
  falla              String
  detalle            String
  /// ¿La camioneta está habilitada para circular?
  habilitadaCircular Boolean           @default(true)
  /// Legacy: true si NO está habilitada para circular
  inhabilitado       Boolean           @default(false)
  createdById        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  camioneta    Camioneta     @relation(fields: [camionetaId], references: [id])
  chofer       Chofer?       @relation(fields: [choferId], references: [id])
  ordenTrabajo OrdenTrabajo?
}

/// Orden de trabajo — 6 etapas (currentStep 0..5)
/// 0 Solicitud · 1 Notif. ops (Pablo/Facu) · 2 Presupuestos (Silvina, hasta 3)
/// 3 Elección taller (Facu) · 4 Aprobación+factura (Patricio) · 5 Pago (Silvina/Carla)
model OrdenTrabajo {
  id                       String    @id @default(cuid())
  solicitudTallerId        String    @unique
  numeroOT                 String    @unique
  currentStep              Int       @default(0)
  tallerAsignado           String?
  montoAutorizado          Float?
  plazoEntrega             DateTime?
  /// Legacy single presupuesto (se mantiene por compat)
  presupuestoMonto         Float?
  presupuestoArchivo       String?
  presupuestoElegidoId     String?   @unique
  valorAprobado            Float?
  valorFinal               Float?
  incrementoJustificacion  String?
  facturaPDF               String?
  trabajoDescripcion       String?
  pedidoNotificacionId     String?
  cerradaAt                DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  solicitud            SolicitudTaller @relation(fields: [solicitudTallerId], references: [id])
  presupuestos         PresupuestoOt[]
  presupuestoElegido   PresupuestoOt?  @relation("PresupuestoElegido", fields: [presupuestoElegidoId], references: [id])
  avisos               AvisoInterno[]

  @@index([currentStep])
}

/// Hasta 3 presupuestos PDF por OT (etapa Silvina).
model PresupuestoOt {
  id        String   @id @default(cuid())
  otId      String
  taller    String
  monto     Float
  archivo   String
  createdAt DateTime @default(now())

  ot       OrdenTrabajo  @relation(fields: [otId], references: [id], onDelete: Cascade)
  elegidoEn OrdenTrabajo? @relation("PresupuestoElegido")

  @@index([otId])
}

/// Avisos internos al cerrar una OT (ops, no dueños).
model AvisoInterno {
  id        String   @id @default(cuid())
  rolDestino Role
  titulo    String
  mensaje   String
  otId      String?
  leido     Boolean  @default(false)
  createdAt DateTime @default(now())

  ot OrdenTrabajo? @relation(fields: [otId], references: [id])

  @@index([rolDestino, leido])
  @@index([createdAt])
}

enum TipoComunicacion {
  RESUMEN_09
  OFERTA_12
  CONFIRMACION_15
}

enum EstadoComunicacion {
  ENVIADO
  SIMULADO
  ERROR
}

enum DestinatarioTipo {
  CLIENTE
  CHOFER
}

/// Log de comunicaciones automáticas (M3) — canal EMAIL en el MVP.
model Comunicacion {
  id                 String             @id @default(cuid())
  loteId             String
  tipo               TipoComunicacion
  canal              String             @default("EMAIL")
  destinatarioTipo   DestinatarioTipo
  destinatarioId     String?
  destinatarioNombre String
  destinatarioEmail  String
  asunto             String
  cuerpoTexto        String
  coberturaDesde     DateTime
  coberturaHasta     DateTime
  coberturaLabel     String
  estado             EstadoComunicacion
  errorMensaje       String?
  enviadoAt         DateTime           @default(now())
  createdAt          DateTime           @default(now())

  @@index([enviadoAt])
  @@index([tipo])
  @@index([loteId])
  @@index([estado])
}
