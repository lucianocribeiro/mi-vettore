// Mi Vettore — Prisma schema
// Producción: PostgreSQL (Supabase). DATABASE_URL + DIRECT_URL en env.
//
// TODO (miércoles — pendiente de definición, no implementar aún):
// - Historial de patentes al cambiar de empresa (¿transferir o baja+alta?)
// - Proceso de reactivación post-reparación (quién notifica)
// - Alertas SENASA (standby — no activar)
// - Umbrales de mantenimiento preventivo (servicio/frenos/neumáticos)
// - Mail institucional de notificaciones → usar NOTIF_FROM_EMAIL / SMTP_FROM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CLIENTE
  CHOFER
  PABLO
  SILVINA
  FACU
  PATRICIO
  JULIETA
  CARLA
  SUGERENCIAS
}

enum UserStatus {
  ACTIVO
  INACTIVO
}

enum SegmentoCliente {
  ESTATICO
  CONSULTA
  CONFIRMACION
}

enum EstadoChofer {
  ACTIVO
  INACTIVO
}

enum EstadoCamioneta {
  OPERATIVA
  EN_TALLER
  DE_VACACIONES
  FUERA_SERVICIO
}

enum TipoEmpresa {
  PROPIA
  ALIADA
}

/// Legacy — preferir TipoServicio (ABM). Se mantiene por compat.
enum TipoTransporte {
  CONGELADO
  SUPERCONGELADO
  REFRIGERADO
  SECO
}

enum TipoPedido {
  ALTA
  BAJA
  CAMBIO_HORARIO
  CAMBIO_RUTA
  PEDIDO_ESPECIAL
}

enum EstadoPedido {
  PENDIENTE
  EN_CURSO
  RESUELTO
}

enum OrigenPedido {
  FORMULARIO
  MANUAL
  SISTEMA
}

enum TipoTaller {
  MECANICA
  REPUESTEROS
  GOMERIAS
  BATERIAS
  GNC
  FRIO
}

enum TipoDocumento {
  DNI_FRENTE
  DNI_DORSO
  LICENCIA
  HABILITACION_MANIPULACION
  VTV
  SENASA
  SEGURO
}

enum EstadoValidacionDoc {
  PENDIENTE
  VALIDADO
  RECHAZADO
}

model Usuario {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  rol          Role
  estado       UserStatus @default(ACTIVO)
  nombre       String?
  clienteId    String?
  choferId     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  cliente              Cliente?           @relation(fields: [clienteId], references: [id])
  chofer               Chofer?            @relation(fields: [choferId], references: [id])
  auditorias           OtAuditoria[]
  sugerencias          SugerenciaUsuario[]
  avisos               AvisoInterno[]     @relation("AvisoUsuario")
  docsValidados        DocumentoEntidad[] @relation("DocValidador")
  correccionesAdmin    CorreccionAdmin[]
}

model Cliente {
  id        String          @id @default(cuid())
  nombre    String
  segmento  SegmentoCliente @default(ESTATICO)
  contacto  String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  pedidos   Pedido[]
  usuarios  Usuario[]
}

model Chofer {
  id                  String           @id @default(cuid())
  nombre              String
  dni                 String           @unique
  cuil                String?
  licencia            String?
  licenciaVencimiento DateTime?
  telefono            String?
  email               String?
  /// Empresa unipersonal / titular: misma UI de chofer; ve y rota patentes de su empresa.
  esDuenoFlota        Boolean          @default(false)
  estado              EstadoChofer     @default(ACTIVO)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  asignaciones        AsignacionFlota[]
  pedidos             Pedido[]
  usuarios            Usuario[]
  solicitudes         SolicitudTaller[]
  documentos          DocumentoEntidad[]
}

/// Catálogo configurable de tipos de servicio (congelado, seco, etc.).
model TipoServicio {
  id         String      @id @default(cuid())
  nombre     String      @unique
  activo     Boolean     @default(true)
  orden      Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  camionetas Camioneta[]
}

model Camioneta {
  id                     String           @id @default(cuid())
  patente                String           @unique
  marca                  String?
  modelo                 String?
  /// Año: piso desde 2000 inclusive (<= año actual). Planilla cliente decía >2005 — pendiente miércoles.
  anio                   Int?
  /// Categoría de frío alineada a TipoServicio (Congelado, Supercongelado, Refrigerado, Seco).
  equipoFrio             String?
  /// Número de capacidad (separado de unidad).
  capacidadValor         Int?
  /// Unidad libre: kilos, litros, canastos, baldes, etc.
  capacidadUnidad        String?
  /// Legacy — preferir capacidadValor + capacidadUnidad.
  capacidad              String?
  tipoTransporte         TipoTransporte?
  tipoServicioId         String?
  datosTecnicos          String?
  km                     Int              @default(0)
  /// Última vez que se actualizó el kilometraje (recordatorio 10 días).
  kmActualizadoAt        DateTime?
  fechaUltimoAceite      DateTime?
  fechaCambioCorrea      DateTime?
  fechaCambioNeumaticos  DateTime?
  fechaCambioBateria     DateTime?
  seguroCompania         String?
  seguroVencimiento      DateTime?
  /// VTV (Verificación Técnica Vehicular) — vencimiento
  vtbVencimiento         DateTime?
  estado                 EstadoCamioneta  @default(OPERATIVA)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  asignaciones           AsignacionFlota[]
  pedidos                Pedido[]
  solicitudes            SolicitudTaller[]
  tipoServicio           TipoServicio?    @relation(fields: [tipoServicioId], references: [id])
  documentos             DocumentoEntidad[]
  kmRegistros            KmRegistro[]
}

model EmpresaTransporte {
  id           String           @id @default(cuid())
  nombre       String
  cuit         String?          @unique
  contacto     String?
  tipo         TipoEmpresa      @default(ALIADA)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  asignaciones AsignacionFlota[]
}

/// Vínculo ternario: chofer y patente al mismo nivel bajo la empresa (sin chofer↔patente fijo).
/// TODO (miércoles): al cambiar empresa de una unidad — ¿transferir historial o baja+alta?
model AsignacionFlota {
  id           String    @id @default(cuid())
  camionetaId  String
  choferId     String
  empresaId    String
  periodoDesde DateTime
  periodoHasta DateTime?
  createdAt    DateTime  @default(now())

  camioneta Camioneta         @relation(fields: [camionetaId], references: [id])
  chofer    Chofer            @relation(fields: [choferId], references: [id])
  empresa   EmpresaTransporte @relation(fields: [empresaId], references: [id])

  @@index([camionetaId])
  @@index([choferId])
  @@index([empresaId])
}

model Pedido {
  id               String       @id @default(cuid())
  clienteId        String
  fecha            DateTime
  tipo             TipoPedido
  hora             String?
  zona             String?
  motivo           String
  estado           EstadoPedido @default(PENDIENTE)
  comentarioCierre String?
  choferId         String?
  camionetaId      String?
  origen           OrigenPedido @default(MANUAL)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  cliente   Cliente    @relation(fields: [clienteId], references: [id])
  chofer    Chofer?    @relation(fields: [choferId], references: [id])
  camioneta Camioneta? @relation(fields: [camionetaId], references: [id])

  @@index([fecha])
  @@index([estado])
  @@index([clienteId])
}

enum SolicitanteTaller {
  CHOFER
  ADMINISTRATIVO
}

model SolicitudTaller {
  id                 String            @id @default(cuid())
  camionetaId        String
  choferId           String?
  solicitante        SolicitanteTaller
  /// Texto libre del problema (chofer) o catálogo legacy (ops).
  falla              String
  detalle            String
  habilitadaCircular Boolean           @default(true)
  inhabilitado       Boolean           @default(false)
  createdById        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  camioneta    Camioneta     @relation(fields: [camionetaId], references: [id])
  chofer       Chofer?       @relation(fields: [choferId], references: [id])
  ordenTrabajo OrdenTrabajo?
}

/// 0 Solicitud · 1 Notif. ops · 2 Presupuestos · 3 Elección · 4 Aprobación · 5 Pago+factura
/// TODO (miércoles): proceso de reactivación de unidad/chofer post-reparación.
model OrdenTrabajo {
  id                      String    @id @default(cuid())
  solicitudTallerId       String    @unique
  numeroOT                String    @unique
  currentStep             Int       @default(0)
  tallerAsignado          String?
  montoAutorizado         Float?
  plazoEntrega            DateTime?
  presupuestoMonto        Float?
  presupuestoArchivo      String?
  presupuestoElegidoId    String?   @unique
  valorAprobado           Float?
  valorFinal              Float?
  incrementoJustificacion String?
  facturaPDF              String?
  trabajoDescripcion      String?
  pedidoNotificacionId    String?
  sinPresupuesto          Boolean   @default(false)
  sinPresupuestoMotivo    String?
  cerradaAt               DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  solicitud          SolicitudTaller           @relation(fields: [solicitudTallerId], references: [id])
  presupuestos       PresupuestoOt[]
  presupuestoElegido PresupuestoOt?            @relation("PresupuestoElegido", fields: [presupuestoElegidoId], references: [id])
  avisos             AvisoInterno[]
  auditorias         OtAuditoria[]
  diagnosticos       OrdenTrabajoDiagnostico[]

  @@index([currentStep])
}

model PresupuestoOt {
  id          String   @id @default(cuid())
  otId        String
  taller      String
  monto       Float
  descripcion String?
  archivo     String?
  createdAt   DateTime @default(now())

  ot        OrdenTrabajo  @relation(fields: [otId], references: [id], onDelete: Cascade)
  elegidoEn OrdenTrabajo? @relation("PresupuestoElegido")

  @@index([otId])
}

model OtAuditoria {
  id         String   @id @default(cuid())
  otId       String
  userId     String
  accion     String
  comentario String
  createdAt  DateTime @default(now())

  ot   OrdenTrabajo @relation(fields: [otId], references: [id], onDelete: Cascade)
  user Usuario      @relation(fields: [userId], references: [id])

  @@index([otId])
  @@index([createdAt])
}

model AvisoInterno {
  id         String   @id @default(cuid())
  rolDestino Role?
  usuarioId  String?
  titulo     String
  mensaje    String
  otId       String?
  leido      Boolean  @default(false)
  createdAt  DateTime @default(now())

  ot      OrdenTrabajo? @relation(fields: [otId], references: [id])
  usuario Usuario?      @relation("AvisoUsuario", fields: [usuarioId], references: [id])

  @@index([rolDestino, leido])
  @@index([usuarioId, leido])
  @@index([createdAt])
}

model SugerenciaUsuario {
  id        String   @id @default(cuid())
  userId    String?
  texto     String
  createdAt DateTime @default(now())

  user Usuario? @relation(fields: [userId], references: [id])

  @@index([createdAt])
}

enum TipoComunicacion {
  RESUMEN_09
  OFERTA_12
  CONFIRMACION_15
  RECORDATORIO_KM
  ALERTA_VTV
  ALERTA_LICENCIA
  ALERTA_DOCUMENTO
  ALERTA_KM_ANOMALIA
}

enum EstadoComunicacion {
  ENVIADO
  SIMULADO
  ERROR
}

enum DestinatarioTipo {
  CLIENTE
  CHOFER
}

model Comunicacion {
  id                 String             @id @default(cuid())
  loteId             String
  tipo               TipoComunicacion
  canal              String             @default("EMAIL")
  destinatarioTipo   DestinatarioTipo
  destinatarioId     String?
  destinatarioNombre String
  destinatarioEmail  String
  asunto             String
  cuerpoTexto        String
  coberturaDesde     DateTime
  coberturaHasta     DateTime
  coberturaLabel     String
  estado             EstadoComunicacion
  errorMensaje       String?
  enviadoAt         DateTime           @default(now())
  createdAt          DateTime           @default(now())

  @@index([enviadoAt])
  @@index([tipo])
  @@index([loteId])
  @@index([estado])
}

/// ABM de talleres proveedores (no confundir con /api/talleres = OT).
/// Futuro: automatizar pedido de presupuesto por mail según tipo (no implementar envío aún).
model TallerProveedor {
  id          String   @id @default(cuid())
  cuit        String   @unique
  razonSocial String
  direccion   String?
  mail        String?
  celular     String?
  aliasCbu    String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tipos       TallerProveedorTipo[]
}

model TallerProveedorTipo {
  id      String            @id @default(cuid())
  tallerId String
  tipo    TipoTaller
  taller  TallerProveedor   @relation(fields: [tallerId], references: [id], onDelete: Cascade)

  @@unique([tallerId, tipo])
  @@index([tipo])
}

/// Documentación chofer/unidad — archivos en Supabase Storage (bucket privado).
model DocumentoEntidad {
  id               String               @id @default(cuid())
  tipo             TipoDocumento
  choferId         String?
  camionetaId      String?
  storagePath      String
  mimeType         String
  nombreOriginal   String?
  /// DNI frente/dorso no llevan vencimiento.
  vencimiento      DateTime?
  estadoValidacion EstadoValidacionDoc  @default(PENDIENTE)
  validadoPorId    String?
  motivoRechazo    String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  chofer      Chofer?    @relation(fields: [choferId], references: [id], onDelete: Cascade)
  camioneta   Camioneta? @relation(fields: [camionetaId], references: [id], onDelete: Cascade)
  validadoPor Usuario?   @relation("DocValidador", fields: [validadoPorId], references: [id])

  @@index([choferId])
  @@index([camionetaId])
  @@index([tipo])
  @@index([vencimiento])
}

/// Árbol de diagnóstico jerárquico (nivel 1/2/3) — se usa al final del OT (presupuesto/cierre).
model CategoriaDiagnostico {
  id        String  @id @default(cuid())
  nombre    String
  padreId   String?
  nivel     Int
  activo    Boolean @default(true)
  orden     Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  padre     CategoriaDiagnostico?  @relation("DiagnosticoArbol", fields: [padreId], references: [id])
  hijos     CategoriaDiagnostico[] @relation("DiagnosticoArbol")
  ots       OrdenTrabajoDiagnostico[]

  @@index([padreId])
  @@index([nivel])
}

model OrdenTrabajoDiagnostico {
  id           String @id @default(cuid())
  otId         String
  categoriaId  String
  createdAt    DateTime @default(now())

  ot        OrdenTrabajo         @relation(fields: [otId], references: [id], onDelete: Cascade)
  categoria CategoriaDiagnostico @relation(fields: [categoriaId], references: [id])

  @@unique([otId, categoriaId])
  @@index([otId])
}

model KmRegistro {
  id          String   @id @default(cuid())
  camionetaId String
  kmAnterior  Int
  kmNuevo     Int
  delta       Int
  anomalia    Boolean  @default(false)
  userId      String?
  createdAt   DateTime @default(now())

  camioneta Camioneta @relation(fields: [camionetaId], references: [id], onDelete: Cascade)

  @@index([camionetaId, createdAt])
}

/// Correcciones de admin (Silvina/Patricio/Julieta) con motivo obligatorio.
model CorreccionAdmin {
  id            String   @id @default(cuid())
  entidad       String
  entidadId     String
  campo         String
  valorAnterior String?
  valorNuevo    String?
  motivo        String
  userId        String
  createdAt     DateTime @default(now())

  user Usuario @relation(fields: [userId], references: [id])

  @@index([entidad, entidadId])
  @@index([createdAt])
}
