// Mi Vettore — Prisma schema
// Producción: PostgreSQL (Supabase). DATABASE_URL + DIRECT_URL en env.
//
// TODO (miércoles — pendiente de definición, no implementar aún):
// - Historial de patentes al cambiar de empresa (¿transferir o baja+alta?)
// - Proceso de reactivación post-reparación (quién notifica)
// - Alertas SENASA (standby — no activar)
// - Umbrales de mantenimiento preventivo (servicio/frenos/neumáticos)
// - Mail institucional de notificaciones → usar NOTIF_FROM_EMAIL / SMTP_FROM

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CLIENTE
  CHOFER
  ADMINISTRADOR
  OPERACIONES
  EMPRESA
  SUGERENCIAS
}

enum UserStatus {
  ACTIVO
  INACTIVO
}

enum SegmentoCliente {
  ESTATICO
  CONSULTA
  CONFIRMACION
}

enum EstadoChofer {
  ACTIVO
  INACTIVO
}

enum EstadoCamioneta {
  OPERATIVA
  EN_TALLER
  DE_VACACIONES
  FUERA_SERVICIO
  /// Baja definitiva / vendida. No se lista en vistas normales.
  INACTIVA
}

enum TipoEmpresa {
  PROPIA
  ALIADA
}

/// Legacy — preferir TipoServicio (ABM). Se mantiene por compat.
enum TipoTransporte {
  CONGELADO
  SUPERCONGELADO
  REFRIGERADO
  SECO
}

enum TipoPedido {
  ALTA
  BAJA
  CAMBIO_HORARIO
  CAMBIO_RUTA
  PEDIDO_ESPECIAL
}

enum EstadoPedido {
  PENDIENTE
  EN_CURSO
  RESUELTO
}

enum OrigenPedido {
  FORMULARIO
  MANUAL
  SISTEMA
}

enum TipoTaller {
  MECANICA
  REPUESTEROS
  GOMERIAS
  BATERIAS
  GNC
  FRIO
}

enum TipoDocumento {
  DNI_FRENTE
  DNI_DORSO
  LICENCIA
  LICENCIA_FRENTE
  LICENCIA_DORSO
  HABILITACION_MANIPULACION
  SEGURO_ACCIDENTES
  VTV
  SENASA
  SEGURO
  CEDULA
  HOMOLOGACION
  OTRA_DOCUMENTACION
  FOTO_VEHICULO
}

enum EstadoValidacionDoc {
  PENDIENTE
  VALIDADO
  RECHAZADO
}

model Usuario {
  id           String     @id @default(cuid())
  email        String     @unique
  /// DNI de personas (admin, operaciones, chofer). Único cuando existe.
  dni          String?    @unique
  /// Identificador de login: DNI (personas) o CUIT (empresa). Legado puede ser email hasta cargar DNI.
  loginIdentificador String @unique
  passwordHash String
  debeCambiarPassword Boolean @default(false)
  rol          Role
  estado       UserStatus @default(ACTIVO)
  nombre       String?
  clienteId    String?
  choferId     String?
  empresaId    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  cliente              Cliente?           @relation(fields: [clienteId], references: [id])
  chofer               Chofer?            @relation(fields: [choferId], references: [id])
  empresa              EmpresaTransporte? @relation(fields: [empresaId], references: [id])
  auditorias           OtAuditoria[]
  comentariosOt        OtComentario[]
  sugerencias          SugerenciaUsuario[]
  avisos               AvisoInterno[]     @relation("AvisoUsuario")
  docsValidados        DocumentoEntidad[] @relation("DocValidador")
  correccionesAdmin    CorreccionAdmin[]

  @@index([empresaId])
}

model Cliente {
  id        String          @id @default(cuid())
  nombre    String
  segmento  SegmentoCliente @default(ESTATICO)
  contacto  String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  pedidos   Pedido[]
  usuarios  Usuario[]
}

model Chofer {
  id                  String           @id @default(cuid())
  nombre              String
  apellido            String
  dni                 String           @unique
  empresaId           String
  cuil                String?
  licencia            String?
  licenciaVencimiento DateTime?
  telefono            String?
  email               String?
  /// Empresa unipersonal / titular: misma UI de chofer; ve y rota patentes de su empresa.
  esDuenoFlota        Boolean          @default(false)
  /// Módulos opcionales (Documentación es siempre obligatorio).
  verMantenimiento    Boolean          @default(true)
  verTaller           Boolean          @default(true)
  estado              EstadoChofer     @default(ACTIVO)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  empresa             EmpresaTransporte @relation(fields: [empresaId], references: [id])
  asignaciones        AsignacionFlota[]
  pedidos             Pedido[]
  usuarios            Usuario[]
  solicitudes         SolicitudTaller[]
  documentos          DocumentoEntidad[]

  @@index([empresaId])
}

/// Catálogo configurable de tipos de servicio (congelado, seco, etc.).
model TipoServicio {
  id         String      @id @default(cuid())
  nombre     String      @unique
  activo     Boolean     @default(true)
  orden      Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  camionetas Camioneta[]
  equipoFrioTipos EquipoFrioTipo[]
}

/// Catálogo ABM de marcas de equipo de frío y sus tipos de servicio correspondientes.
model EquipoFrio {
  id        String   @id @default(cuid())
  nombre    String   @unique
  activo    Boolean  @default(true)
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tipos     EquipoFrioTipo[]
}

model EquipoFrioTipo {
  id             String       @id @default(cuid())
  equipoFrioId   String
  tipoServicioId String
  equipoFrio     EquipoFrio   @relation(fields: [equipoFrioId], references: [id], onDelete: Cascade)
  tipoServicio   TipoServicio @relation(fields: [tipoServicioId], references: [id], onDelete: Cascade)

  @@unique([equipoFrioId, tipoServicioId])
  @@index([tipoServicioId])
}

/// Catálogo ABM de marcas de unidad (camioneta) y sus modelos.
model MarcaCamioneta {
  id        String           @id @default(cuid())
  nombre    String           @unique
  activo    Boolean          @default(true)
  orden     Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  modelos   ModeloCamioneta[]
}

model ModeloCamioneta {
  id        String         @id @default(cuid())
  marcaId   String
  nombre    String
  activo    Boolean        @default(true)
  orden     Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  marca     MarcaCamioneta @relation(fields: [marcaId], references: [id], onDelete: Cascade)

  @@unique([marcaId, nombre])
  @@index([marcaId])
}

model Camioneta {
  id                     String           @id @default(cuid())
  patente                String           @unique
  marca                  String?
  modelo                 String?
  /// Año: piso desde 2000 inclusive (<= año actual). Planilla cliente decía >2005 — pendiente miércoles.
  anio                   Int?
  /// Marca del equipo de frío (Carrier, Thermo King, etc.).
  equipoFrio             String?
  /// Empresa de transporte propietaria de la unidad (obligatoria).
  empresaId              String
  /// Número de capacidad (separado de unidad).
  capacidadValor         Int?
  /// Unidad libre: kilos, litros, canastos, baldes, etc.
  capacidadUnidad        String?
  /// Legacy — preferir capacidadValor + capacidadUnidad.
  capacidad              String?
  tipoTransporte         TipoTransporte?
  tipoServicioId         String?
  datosTecnicos          String?
  km                     Int              @default(0)
  /// Última vez que se actualizó el kilometraje (recordatorio 10 días).
  kmActualizadoAt        DateTime?
  fechaUltimoAceite      DateTime?
  fechaCambioCorrea      DateTime?
  fechaCambioNeumaticos  DateTime?
  fechaCambioBateria     DateTime?
  seguroCompania         String?
  seguroVencimiento      DateTime?
  /// VTV (Verificación Técnica Vehicular) — vencimiento
  vtbVencimiento         DateTime?
  estado                 EstadoCamioneta  @default(OPERATIVA)
  /// Periodo en que la unidad permanece en estado no operativo (taller / vacaciones / fuera).
  estadoDesde            DateTime?
  estadoHasta            DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  asignaciones           AsignacionFlota[]
  pedidos                Pedido[]
  solicitudes            SolicitudTaller[]
  tipoServicio           TipoServicio?    @relation(fields: [tipoServicioId], references: [id])
  empresa                EmpresaTransporte @relation("EmpresaUnidades", fields: [empresaId], references: [id])
  documentos             DocumentoEntidad[]
  kmRegistros            KmRegistro[]
  registrosMantenimiento RegistroMantenimiento[]

  @@index([empresaId])
}

model EmpresaTransporte {
  id                     String           @id @default(cuid())
  nombre                 String
  cuit                   String           @unique
  contacto               String?
  tipo                   TipoEmpresa      @default(ALIADA)
  /// Si true, un mismo chofer puede tener varias camionetas activas de esta empresa.
  permiteMultiCamioneta  Boolean          @default(true)
  activo                 Boolean          @default(true)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  asignaciones           AsignacionFlota[]
  unidades               Camioneta[]      @relation("EmpresaUnidades")
  choferes               Chofer[]
  usuarios               Usuario[]
}

/// Vínculo ternario: chofer y patente al mismo nivel bajo la empresa (sin chofer↔patente fijo).
/// TODO (miércoles): al cambiar empresa de una unidad — ¿transferir historial o baja+alta?
model AsignacionFlota {
  id           String    @id @default(cuid())
  camionetaId  String
  choferId     String
  empresaId    String
  periodoDesde DateTime
  periodoHasta DateTime?
  createdAt    DateTime  @default(now())

  camioneta Camioneta         @relation(fields: [camionetaId], references: [id])
  chofer    Chofer            @relation(fields: [choferId], references: [id])
  empresa   EmpresaTransporte @relation(fields: [empresaId], references: [id])

  @@index([camionetaId])
  @@index([choferId])
  @@index([empresaId])
}

model Pedido {
  id               String       @id @default(cuid())
  clienteId        String
  fecha            DateTime
  tipo             TipoPedido
  hora             String?
  zona             String?
  motivo           String
  estado           EstadoPedido @default(PENDIENTE)
  comentarioCierre String?
  choferId         String?
  camionetaId      String?
  origen           OrigenPedido @default(MANUAL)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  cliente   Cliente    @relation(fields: [clienteId], references: [id])
  chofer    Chofer?    @relation(fields: [choferId], references: [id])
  camioneta Camioneta? @relation(fields: [camionetaId], references: [id])

  @@index([fecha])
  @@index([estado])
  @@index([clienteId])
}

enum SolicitanteTaller {
  CHOFER
  ADMINISTRATIVO
}

model SolicitudTaller {
  id                 String            @id @default(cuid())
  camionetaId        String
  choferId           String?
  solicitante        SolicitanteTaller
  /// Texto libre del problema (chofer) o catálogo legacy (ops).
  falla              String
  detalle            String
  habilitadaCircular Boolean           @default(true)
  inhabilitado       Boolean           @default(false)
  createdById        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  camioneta    Camioneta     @relation(fields: [camionetaId], references: [id])
  chofer       Chofer?       @relation(fields: [choferId], references: [id])
  ordenTrabajo OrdenTrabajo?
}

/// 0 Solicitud · 1 Asignación Facu · 2 Presupuestos · 3 Facturación · 4 Incremento · 5 Cierre/pago
/// TODO (miércoles): proceso de reactivación de unidad/chofer post-reparación.
/// Circuito OT 5 pasos: 0 solicitud, 1 presupuesto, 2 selección, 3 ajuste, 4 comparación/cierre.
model OrdenTrabajo {
  id                      String    @id @default(cuid())
  solicitudTallerId       String    @unique
  numeroOT                String    @unique
  currentStep             Int       @default(0)
  /// Máximo paso alcanzado (no baja al retroceder; sirve para el indicador verde).
  maxStepReached          Int       @default(0)
  /// Unidad no puede circular → camino corto (rendición 24hs).
  urgente                 Boolean   @default(false)
  tallerAsignado          String?
  tallerProveedorId       String?
  kmAlMomento             Int?
  sugerenciaChofer        String?
  sugerenciaArchivo       String?
  montoAutorizado         Float?
  plazoEntrega            DateTime?
  presupuestoMonto        Float?
  presupuestoArchivo      String?
  presupuestoElegidoId    String?   @unique
  valorAprobado           Float?
  valorFinal              Float?
  incrementoJustificacion String?
  incrementoAprobadoAt    DateTime?
  facturaPDF              String?
  trabajoDescripcion      String?
  pedidoNotificacionId    String?
  sinPresupuesto          Boolean   @default(false)
  sinPresupuestoMotivo    String?
  cerradaAt               DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  solicitud          SolicitudTaller           @relation(fields: [solicitudTallerId], references: [id])
  tallerProveedor    TallerProveedor?          @relation(fields: [tallerProveedorId], references: [id])
  presupuestos       PresupuestoOt[]
  presupuestoElegido PresupuestoOt?            @relation("PresupuestoElegido", fields: [presupuestoElegidoId], references: [id])
  items              OtItem[]
  facturas           OtFactura[]
  comentarios        OtComentario[]
  avisos             AvisoInterno[]
  auditorias         OtAuditoria[]
  diagnosticos       OrdenTrabajoDiagnostico[]
  movimientos        TallerMovimiento[]

  @@index([currentStep])
  @@index([urgente])
  @@index([tallerProveedorId])
}

/// Comentario libre sobre la OT (chofer, dueño flota u oficina).
model OtComentario {
  id        String   @id @default(cuid())
  otId      String
  userId    String
  texto     String
  createdAt DateTime @default(now())

  ot   OrdenTrabajo @relation(fields: [otId], references: [id], onDelete: Cascade)
  user Usuario      @relation(fields: [userId], references: [id])

  @@index([otId])
  @@index([createdAt])
}

model PresupuestoOt {
  id          String   @id @default(cuid())
  otId        String
  taller      String
  monto       Float
  descripcion String?
  archivo     String?
  createdAt   DateTime @default(now())

  ot        OrdenTrabajo  @relation(fields: [otId], references: [id], onDelete: Cascade)
  elegidoEn OrdenTrabajo? @relation("PresupuestoElegido")

  @@index([otId])
}

model OtAuditoria {
  id         String   @id @default(cuid())
  otId       String
  userId     String
  accion     String
  comentario String   @default("")
  createdAt  DateTime @default(now())

  ot   OrdenTrabajo @relation(fields: [otId], references: [id], onDelete: Cascade)
  user Usuario      @relation(fields: [userId], references: [id])

  @@index([otId])
  @@index([createdAt])
}

model AvisoInterno {
  id         String   @id @default(cuid())
  rolDestino Role?
  usuarioId  String?
  titulo     String
  mensaje    String
  otId       String?
  leido      Boolean  @default(false)
  createdAt  DateTime @default(now())

  ot      OrdenTrabajo? @relation(fields: [otId], references: [id])
  usuario Usuario?      @relation("AvisoUsuario", fields: [usuarioId], references: [id])

  @@index([rolDestino, leido])
  @@index([usuarioId, leido])
  @@index([createdAt])
}

enum EstadoSugerencia {
  PENDIENTE
  HECHO
}

model SugerenciaUsuario {
  id        String            @id @default(cuid())
  userId    String?
  texto     String
  estado    EstadoSugerencia  @default(PENDIENTE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user Usuario? @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([estado])
}

enum TipoComunicacion {
  RESUMEN_09
  OFERTA_12
  CONFIRMACION_15
  RECORDATORIO_KM
  ALERTA_VTV
  ALERTA_LICENCIA
  ALERTA_DOCUMENTO
  ALERTA_KM_ANOMALIA
}

enum EstadoComunicacion {
  ENVIADO
  SIMULADO
  ERROR
}

enum DestinatarioTipo {
  CLIENTE
  CHOFER
}

model Comunicacion {
  id                 String             @id @default(cuid())
  loteId             String
  tipo               TipoComunicacion
  canal              String             @default("EMAIL")
  destinatarioTipo   DestinatarioTipo
  destinatarioId     String?
  destinatarioNombre String
  destinatarioEmail  String
  asunto             String
  cuerpoTexto        String
  coberturaDesde     DateTime
  coberturaHasta     DateTime
  coberturaLabel     String
  estado             EstadoComunicacion
  errorMensaje       String?
  enviadoAt         DateTime           @default(now())
  createdAt          DateTime           @default(now())

  @@index([enviadoAt])
  @@index([tipo])
  @@index([loteId])
  @@index([estado])
}

enum TipoOtItem {
  PRESUPUESTO
  FACTURA
  RENDICION
}

enum ClasificacionGasto {
  MANO_OBRA
  MATERIALES
  OTRO
}

enum EstadoTallerMovimiento {
  PENDIENTE
  PAGADO
}

enum MetodoPagoTaller {
  TRANSFERENCIA
  CHEQUE
  EFECTIVO
}

/// Ítems de presupuesto/factura de una OT (varios proveedores en la misma orden).
model OtItem {
  id                     String              @id @default(cuid())
  otId                   String
  tipo                   TipoOtItem
  tallerProveedorId      String?
  tallerNombre           String              @default("")
  descripcion            String
  importe                Float
  observacion            String?
  archivo                String?
  aprobado               Boolean             @default(false)
  /// Ítem agregado en ajuste de importes (reparación adicional).
  adicionalAjuste        Boolean             @default(false)
  /// Sugerencia de aprobación de la empresa (dueño flota) en etapa aprobacion_empresa.
  sugeridoEmpresa        Boolean             @default(false)
  clasificacion          ClasificacionGasto?
  clasificacionOtro      String?
  /// Concepto 3 niveles (hoja del árbol CategoriaDiagnostico) al facturar.
  categoriaDiagnosticoId String?
  /// Fecha del gasto (editable; por defecto hoy al cargar).
  fecha                  DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  ot                   OrdenTrabajo          @relation(fields: [otId], references: [id], onDelete: Cascade)
  tallerProveedor      TallerProveedor?      @relation(fields: [tallerProveedorId], references: [id])
  categoriaDiagnostico CategoriaDiagnostico? @relation(fields: [categoriaDiagnosticoId], references: [id])

  @@index([otId])
  @@index([tipo])
  @@index([categoriaDiagnosticoId])
}

/// Adjuntos de factura (PDF/foto) — más de uno por OT.
model OtFactura {
  id                String   @id @default(cuid())
  otId              String
  tallerProveedorId String?
  tallerNombre      String   @default("")
  archivo           String
  nombreOriginal    String?
  mimeType          String?
  monto             Float?
  createdAt         DateTime @default(now())

  ot              OrdenTrabajo     @relation(fields: [otId], references: [id], onDelete: Cascade)
  tallerProveedor TallerProveedor? @relation(fields: [tallerProveedorId], references: [id])

  @@index([otId])
}

/// Historia de cuenta corriente por taller/proveedor.
model TallerMovimiento {
  id              String                 @id @default(cuid())
  tallerProveedorId String
  otId            String?
  montoFacturado  Float
  fechaFactura    DateTime               @default(now())
  fechaPago       DateTime?
  metodoPago      MetodoPagoTaller?
  estado          EstadoTallerMovimiento @default(PENDIENTE)
  createdAt       DateTime               @default(now())

  tallerProveedor TallerProveedor @relation(fields: [tallerProveedorId], references: [id], onDelete: Cascade)
  ot              OrdenTrabajo?   @relation(fields: [otId], references: [id], onDelete: SetNull)

  @@index([tallerProveedorId, estado])
  @@index([otId])
}

/// ABM de talleres proveedores (no confundir con /api/talleres = OT).
/// Futuro: automatizar pedido de presupuesto por mail según tipo (no implementar envío aún).
model TallerProveedor {
  id          String   @id @default(cuid())
  cuit        String   @unique
  razonSocial String
  direccion   String?
  mail        String?
  celular     String?
  /// Si true, el celular admite contacto por WhatsApp.
  whatsapp    Boolean  @default(false)
  aliasCbu    String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tipos       TallerProveedorTipo[]
  ots         OrdenTrabajo[]
  items       OtItem[]
  facturas    OtFactura[]
  movimientos TallerMovimiento[]
}

model TallerProveedorTipo {
  id      String            @id @default(cuid())
  tallerId String
  tipo    TipoTaller
  taller  TallerProveedor   @relation(fields: [tallerId], references: [id], onDelete: Cascade)

  @@unique([tallerId, tipo])
  @@index([tipo])
}

/// Documentación chofer/unidad — archivos en Supabase Storage (bucket privado).
model DocumentoEntidad {
  id               String               @id @default(cuid())
  tipo             TipoDocumento
  choferId         String?
  camionetaId      String?
  storagePath      String
  mimeType         String
  nombreOriginal   String?
  /// DNI frente/dorso no llevan vencimiento.
  vencimiento      DateTime?
  estadoValidacion EstadoValidacionDoc  @default(PENDIENTE)
  validadoPorId    String?
  motivoRechazo    String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  chofer      Chofer?    @relation(fields: [choferId], references: [id], onDelete: Cascade)
  camioneta   Camioneta? @relation(fields: [camionetaId], references: [id], onDelete: Cascade)
  validadoPor Usuario?   @relation("DocValidador", fields: [validadoPorId], references: [id])

  @@index([choferId])
  @@index([camionetaId])
  @@index([tipo])
  @@index([vencimiento])
}

/// Árbol de diagnóstico jerárquico (nivel 1/2/3) — se usa al final del OT (presupuesto/cierre).
model CategoriaDiagnostico {
  id        String  @id @default(cuid())
  nombre    String
  padreId   String?
  nivel     Int
  activo    Boolean @default(true)
  orden     Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  padre     CategoriaDiagnostico?  @relation("DiagnosticoArbol", fields: [padreId], references: [id])
  hijos     CategoriaDiagnostico[] @relation("DiagnosticoArbol")
  ots       OrdenTrabajoDiagnostico[]
  items     OtItem[]

  @@index([padreId])
  @@index([nivel])
}

model OrdenTrabajoDiagnostico {
  id           String @id @default(cuid())
  otId         String
  categoriaId  String
  createdAt    DateTime @default(now())

  ot        OrdenTrabajo         @relation(fields: [otId], references: [id], onDelete: Cascade)
  categoria CategoriaDiagnostico @relation(fields: [categoriaId], references: [id])

  @@unique([otId, categoriaId])
  @@index([otId])
}

model KmRegistro {
  id          String   @id @default(cuid())
  camionetaId String
  kmAnterior  Int
  kmNuevo     Int
  delta       Int
  anomalia    Boolean  @default(false)
  userId      String?
  createdAt   DateTime @default(now())

  camioneta Camioneta @relation(fields: [camionetaId], references: [id], onDelete: Cascade)

  @@index([camionetaId, createdAt])
}

/// Correcciones de admin (Silvina/Patricio/Julieta) con motivo obligatorio.
model CorreccionAdmin {
  id            String   @id @default(cuid())
  entidad       String
  entidadId     String
  campo         String
  valorAnterior String?
  valorNuevo    String?
  motivo        String
  userId        String
  createdAt     DateTime @default(now())

  user Usuario @relation(fields: [userId], references: [id])

  @@index([entidad, entidadId])
  @@index([createdAt])
}

/// Línea de base de mantenimiento (import 2026 / OT cerradas). No es carga libre del chofer.
model RegistroMantenimiento {
  id           String    @id @default(cuid())
  camionetaId  String
  fecha        DateTime
  km           Int?
  tipo         String
  detalle      String?
  tallerNombre String?
  otId         String?
  fuente       String    @default("IMPORT_2026")
  createdAt    DateTime  @default(now())

  camioneta Camioneta @relation(fields: [camionetaId], references: [id], onDelete: Cascade)

  @@index([camionetaId, fecha])
}
