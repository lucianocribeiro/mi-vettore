// Mi Vettore — Prisma schema
// Producción: PostgreSQL (Neon). DATABASE_URL en env.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENTE
  CHOFER
  PABLO
  SILVINA
  FACU
  PATRICIO
  JULIETA
  CARLA
  SUGERENCIAS
}

enum UserStatus {
  ACTIVO
  INACTIVO
}

enum SegmentoCliente {
  ESTATICO
  CONSULTA
  CONFIRMACION
}

enum EstadoChofer {
  ACTIVO
  INACTIVO
}

enum EstadoCamioneta {
  OPERATIVA
  EN_TALLER
  DE_VACACIONES
  FUERA_SERVICIO
}

enum TipoEmpresa {
  PROPIA
  ALIADA
}

/// Legacy — preferir TipoServicio (ABM). Se mantiene por compat.
enum TipoTransporte {
  CONGELADO
  SUPERCONGELADO
  REFRIGERADO
  SECO
}

enum TipoPedido {
  ALTA
  BAJA
  CAMBIO_HORARIO
  CAMBIO_RUTA
  PEDIDO_ESPECIAL
}

enum EstadoPedido {
  PENDIENTE
  EN_CURSO
  RESUELTO
}

enum OrigenPedido {
  FORMULARIO
  MANUAL
  SISTEMA
}

model Usuario {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  rol          Role
  estado       UserStatus @default(ACTIVO)
  nombre       String?
  clienteId    String?
  choferId     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  cliente     Cliente?          @relation(fields: [clienteId], references: [id])
  chofer      Chofer?           @relation(fields: [choferId], references: [id])
  auditorias  OtAuditoria[]
  sugerencias SugerenciaUsuario[]
  avisos      AvisoInterno[]    @relation("AvisoUsuario")
}

model Cliente {
  id        String          @id @default(cuid())
  nombre    String
  segmento  SegmentoCliente @default(ESTATICO)
  contacto  String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  pedidos   Pedido[]
  usuarios  Usuario[]
}

model Chofer {
  id                  String           @id @default(cuid())
  nombre              String
  dni                 String           @unique
  cuil                String?
  licencia            String?
  licenciaVencimiento DateTime?
  telefono            String?
  email               String?
  /// Empresa de transporte (titular): ve todas las unidades de su/s empresa/s.
  esDuenoFlota        Boolean          @default(false)
  estado              EstadoChofer     @default(ACTIVO)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  asignaciones        AsignacionFlota[]
  pedidos             Pedido[]
  usuarios            Usuario[]
  solicitudes         SolicitudTaller[]
}

/// Catálogo configurable de tipos de servicio (congelado, seco, etc.).
model TipoServicio {
  id         String      @id @default(cuid())
  nombre     String      @unique
  activo     Boolean     @default(true)
  orden      Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  camionetas Camioneta[]
}

model Camioneta {
  id                     String           @id @default(cuid())
  patente                String           @unique
  marca                  String?
  modelo                 String?
  anio                   Int?
  /// Descripción del equipo de frío (reemplaza color).
  equipoFrio             String?
  capacidad              String?
  tipoTransporte         TipoTransporte?
  tipoServicioId         String?
  datosTecnicos          String?
  km                     Int              @default(0)
  fechaUltimoAceite      DateTime?
  fechaCambioCorrea      DateTime?
  fechaCambioNeumaticos  DateTime?
  fechaCambioBateria     DateTime?
  seguroCompania         String?
  seguroVencimiento      DateTime?
  /// VTV (Verificación Técnica Vehicular) — vencimiento
  vtbVencimiento         DateTime?
  estado                 EstadoCamioneta  @default(OPERATIVA)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  asignaciones           AsignacionFlota[]
  pedidos                Pedido[]
  solicitudes            SolicitudTaller[]
  tipoServicio           TipoServicio?    @relation(fields: [tipoServicioId], references: [id])
}

model EmpresaTransporte {
  id           String           @id @default(cuid())
  nombre       String
  cuit         String?          @unique
  contacto     String?
  tipo         TipoEmpresa      @default(ALIADA)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  asignaciones AsignacionFlota[]
}

model AsignacionFlota {
  id           String    @id @default(cuid())
  camionetaId  String
  choferId     String
  empresaId    String
  periodoDesde DateTime
  periodoHasta DateTime?
  createdAt    DateTime  @default(now())

  camioneta Camioneta         @relation(fields: [camionetaId], references: [id])
  chofer    Chofer            @relation(fields: [choferId], references: [id])
  empresa   EmpresaTransporte @relation(fields: [empresaId], references: [id])

  @@index([camionetaId])
  @@index([choferId])
  @@index([empresaId])
}

model Pedido {
  id               String       @id @default(cuid())
  clienteId        String
  fecha            DateTime
  tipo             TipoPedido
  hora             String?
  zona             String?
  motivo           String
  estado           EstadoPedido @default(PENDIENTE)
  comentarioCierre String?
  choferId         String?
  camionetaId      String?
  origen           OrigenPedido @default(MANUAL)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  cliente   Cliente    @relation(fields: [clienteId], references: [id])
  chofer    Chofer?    @relation(fields: [choferId], references: [id])
  camioneta Camioneta? @relation(fields: [camionetaId], references: [id])

  @@index([fecha])
  @@index([estado])
  @@index([clienteId])
}

enum SolicitanteTaller {
  CHOFER
  ADMINISTRATIVO
}

model SolicitudTaller {
  id                 String            @id @default(cuid())
  camionetaId        String
  choferId           String?
  solicitante        SolicitanteTaller
  falla              String
  detalle            String
  habilitadaCircular Boolean           @default(true)
  inhabilitado       Boolean           @default(false)
  createdById        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  camioneta    Camioneta     @relation(fields: [camionetaId], references: [id])
  chofer       Chofer?       @relation(fields: [choferId], references: [id])
  ordenTrabajo OrdenTrabajo?
}

/// 0 Solicitud · 1 Notif. ops · 2 Presupuestos · 3 Elección · 4 Aprobación · 5 Pago+factura
model OrdenTrabajo {
  id                      String    @id @default(cuid())
  solicitudTallerId       String    @unique
  numeroOT                String    @unique
  currentStep             Int       @default(0)
  tallerAsignado          String?
  montoAutorizado         Float?
  plazoEntrega            DateTime?
  presupuestoMonto        Float?
  presupuestoArchivo      String?
  presupuestoElegidoId    String?   @unique
  valorAprobado           Float?
  valorFinal              Float?
  incrementoJustificacion String?
  facturaPDF              String?
  trabajoDescripcion      String?
  pedidoNotificacionId    String?
  sinPresupuesto          Boolean   @default(false)
  sinPresupuestoMotivo    String?
  cerradaAt               DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  solicitud          SolicitudTaller @relation(fields: [solicitudTallerId], references: [id])
  presupuestos       PresupuestoOt[]
  presupuestoElegido PresupuestoOt?  @relation("PresupuestoElegido", fields: [presupuestoElegidoId], references: [id])
  avisos             AvisoInterno[]
  auditorias         OtAuditoria[]

  @@index([currentStep])
}

model PresupuestoOt {
  id          String   @id @default(cuid())
  otId        String
  taller      String
  monto       Float
  descripcion String?
  archivo     String?
  createdAt   DateTime @default(now())

  ot        OrdenTrabajo  @relation(fields: [otId], references: [id], onDelete: Cascade)
  elegidoEn OrdenTrabajo? @relation("PresupuestoElegido")

  @@index([otId])
}

model OtAuditoria {
  id         String   @id @default(cuid())
  otId       String
  userId     String
  accion     String
  comentario String
  createdAt  DateTime @default(now())

  ot   OrdenTrabajo @relation(fields: [otId], references: [id], onDelete: Cascade)
  user Usuario      @relation(fields: [userId], references: [id])

  @@index([otId])
  @@index([createdAt])
}

model AvisoInterno {
  id         String  @id @default(cuid())
  rolDestino Role?
  usuarioId  String?
  titulo     String
  mensaje    String
  otId       String?
  leido      Boolean @default(false)
  createdAt  DateTime @default(now())

  ot      OrdenTrabajo? @relation(fields: [otId], references: [id])
  usuario Usuario?      @relation("AvisoUsuario", fields: [usuarioId], references: [id])

  @@index([rolDestino, leido])
  @@index([usuarioId, leido])
  @@index([createdAt])
}

model SugerenciaUsuario {
  id        String   @id @default(cuid())
  userId    String?
  texto     String
  createdAt DateTime @default(now())

  user Usuario? @relation(fields: [userId], references: [id])

  @@index([createdAt])
}

enum TipoComunicacion {
  RESUMEN_09
  OFERTA_12
  CONFIRMACION_15
  RECORDATORIO_KM
  ALERTA_VTV
  ALERTA_LICENCIA
}

enum EstadoComunicacion {
  ENVIADO
  SIMULADO
  ERROR
}

enum DestinatarioTipo {
  CLIENTE
  CHOFER
}

model Comunicacion {
  id                 String             @id @default(cuid())
  loteId             String
  tipo               TipoComunicacion
  canal              String             @default("EMAIL")
  destinatarioTipo   DestinatarioTipo
  destinatarioId     String?
  destinatarioNombre String
  destinatarioEmail  String
  asunto             String
  cuerpoTexto        String
  coberturaDesde     DateTime
  coberturaHasta     DateTime
  coberturaLabel     String
  estado             EstadoComunicacion
  errorMensaje       String?
  enviadoAt         DateTime           @default(now())
  createdAt          DateTime           @default(now())

  @@index([enviadoAt])
  @@index([tipo])
  @@index([loteId])
  @@index([estado])
}
